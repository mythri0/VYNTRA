# VYNTRA Analytics — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# .env is already listed in .gitignore.
#
# After editing .env, restart the Vite dev server:
#   npm run dev

# ── Google Apps Script webhook URL ─────────────────────────────────────────
# Paste the "Web app URL" from:
#   Apps Script editor → Deploy → Manage deployments → Web app → Copy URL
#
# Your current deployed URL (update after each new deployment):
VITE_ANALYTICS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── Shared secret (optional, recommended for production) ───────────────────
# Must match the WEBHOOK_SECRET variable at the top of Code.gs.
# Leave empty if WEBHOOK_SECRET in Code.gs is '' (the default).
VITE_ANALYTICS_SECRET=

# ── Google Spreadsheet ID (for reference only — used server-side in Code.gs)
# SPREADSHEET_ID=1K3mlBZIV3Im3U-DVKafl1eWpmE0LUzd5T7Uxzto3lYw
